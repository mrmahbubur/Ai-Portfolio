{
  "entities": {
    "Subscriber": {
      "title": "Subscriber",
      "description": "Visitor who opted in to receive platform, project, and utility update notifications from M R S Assistant.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "Subscriber's email address.",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
        },
        "name": {
          "type": "string",
          "description": "Optional non-blank single-line name or greeting title.",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[^\\r\\n]*\\S[^\\r\\n]*$"
        },
        "uid": {
          "type": "string",
          "description": "Optional linked Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "subscribedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO-8601 UTC/offset timestamp of when the subscription occurred.",
          "minLength": 19,
          "maxLength": 64,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "receivePlatformUpdates": {
          "type": "boolean",
          "description": "Whether to receive automated new platform release announcements."
        },
        "receiveBlogUpdates": {
          "type": "boolean",
          "description": "Whether to receive technical blog & tutorial articles."
        }
      },
      "required": ["email", "subscribedAt", "receivePlatformUpdates"]
    },
    "Inquiry": {
      "title": "Inquiry",
      "description": "Direct contact or project inquiry sent to M R S.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Full single-line name of the inquiring sender.",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[^\\r\\n]*\\S[^\\r\\n]*$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Reply-to email address.",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
        },
        "subject": {
          "type": "string",
          "description": "Single-line subject of inquiry or project title.",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[^\\r\\n]*\\S[^\\r\\n]*$"
        },
        "message": {
          "type": "string",
          "description": "Detailed non-blank body of the inquiry message.",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "^[\\s\\S]*\\S[\\s\\S]*$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO-8601 creation timestamp.",
          "minLength": 19,
          "maxLength": 64,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$"
        }
      },
      "required": ["name", "email", "subject", "message", "createdAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Visitor account profile storing preferences and notification settings.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth user identifier.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Account email address.",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Single-line non-blank display name.",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[^\\r\\n]*\\S[^\\r\\n]*$"
        },
        "receivePlatformUpdates": {
          "type": "boolean",
          "description": "Subscribed to new platform alerts."
        },
        "receiveBlogUpdates": {
          "type": "boolean",
          "description": "Subscribed to blog updates."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO-8601 account creation timestamp.",
          "minLength": 19,
          "maxLength": 64,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO-8601 last settings update timestamp.",
          "minLength": 19,
          "maxLength": 64,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$"
        }
      },
      "required": ["uid", "email", "createdAt"]
    }
  },
  "firestore": {
    "/subscribers/{subscriberId}": {
      "schema": {
        "$ref": "#/entities/Subscriber"
      },
      "description": "Collection storing subscriber preferences for platform and project updates."
    },
    "/inquiries/{inquiryId}": {
      "schema": {
        "$ref": "#/entities/Inquiry"
      },
      "description": "Collection storing visitor contact messages submitted to M R S."
    },
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Collection storing visitor profiles and subscription controls."
    }
  }
}
