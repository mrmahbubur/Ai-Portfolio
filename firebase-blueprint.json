{
  "entities": {
    "Subscriber": {
      "title": "Subscriber",
      "description": "Visitor who opted in to receive platform, project, and utility update notifications from M R S Assistant.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "Subscriber's email address.",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "description": "Optional name or greeting title.",
          "maxLength": 100
        },
        "uid": {
          "type": "string",
          "description": "Optional linked Firebase Auth UID.",
          "maxLength": 128
        },
        "subscribedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of when the subscription occurred."
        },
        "receivePlatformUpdates": {
          "type": "boolean",
          "description": "Whether to receive automated new platform release announcements."
        },
        "receiveBlogUpdates": {
          "type": "boolean",
          "description": "Whether to receive technical blog & tutorial articles."
        }
      },
      "required": ["email", "subscribedAt", "receivePlatformUpdates"]
    },
    "Inquiry": {
      "title": "Inquiry",
      "description": "Direct contact or project inquiry sent to M R S.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Full name of the inquiring sender.",
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Reply-to email address.",
          "maxLength": 128
        },
        "subject": {
          "type": "string",
          "description": "Subject of inquiry or project title.",
          "maxLength": 200
        },
        "message": {
          "type": "string",
          "description": "Detailed body of the inquiry message.",
          "maxLength": 2000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp."
        }
      },
      "required": ["name", "email", "subject", "message", "createdAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Visitor account profile storing preferences and notification settings.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth user identifier.",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Account email address.",
          "maxLength": 128
        },
        "displayName": {
          "type": "string",
          "description": "Display name.",
          "maxLength": 100
        },
        "receivePlatformUpdates": {
          "type": "boolean",
          "description": "Subscribed to new platform alerts."
        },
        "receiveBlogUpdates": {
          "type": "boolean",
          "description": "Subscribed to blog updates."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Account creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last settings update timestamp."
        }
      },
      "required": ["uid", "email", "createdAt"]
    }
  },
  "firestore": {
    "/subscribers/{subscriberId}": {
      "schema": {
        "$ref": "#/entities/Subscriber"
      },
      "description": "Collection storing subscriber preferences for platform and project updates."
    },
    "/inquiries/{inquiryId}": {
      "schema": {
        "$ref": "#/entities/Inquiry"
      },
      "description": "Collection storing visitor contact messages submitted to M R S."
    },
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Collection storing visitor profiles and subscription controls."
    }
  }
}
