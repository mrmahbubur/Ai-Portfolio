# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GRAVATAR_API_KEY: Optional API Key / Bearer token from Gravatar Developer Portal.
# Unlocks authenticated rate limits, verified account badge sync, and full profile data.
GRAVATAR_API_KEY=""

# GMAIL_USER: The Gmail account used for sending outgoing notification emails via Gmail SMTP.
# Defaults to mr216873@gmail.com
GMAIL_USER="mr216873@gmail.com"

# GMAIL_APP_PASSWORD: 16-character Google App Password for Gmail SMTP authentication.
# Generate via: Google Account > Security > 2-Step Verification > App passwords.
GMAIL_APP_PASSWORD=""

# GMAIL_RECIPIENT: The destination Gmail address where all visitor inquiries and messages are delivered.
# Defaults to mr216873@gmail.com
GMAIL_RECIPIENT="mr216873@gmail.com"

# ADMIN_SECRET: Optional admin token protecting maintenance and report endpoints.
ADMIN_SECRET=

# PORT: Server HTTP listening port.
# Render automatically injects PORT at runtime; defaults to 3000 locally.
PORT=3000
