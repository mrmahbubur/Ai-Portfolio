rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all rule for security
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable validation helpers
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Administrative verification based on portfolio owner email
    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email == 'mr216873@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    // User Profile Validation & RBAC
    function isValidUserProfile(data) {
      return data.uid is string && data.uid.size() <= 128 &&
        data.email is string && data.email.size() <= 128 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
        (!('receivePlatformUpdates' in data) || data.receivePlatformUpdates is bool) &&
        (!('receiveBlogUpdates' in data) || data.receiveBlogUpdates is bool) &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() &&
        isValidId(userId) &&
        request.auth.uid == userId &&
        incoming().uid == request.auth.uid &&
        isValidUserProfile(incoming());
      allow update: if isSignedIn() &&
        isValidId(userId) &&
        request.auth.uid == userId &&
        incoming().uid == existing().uid &&
        isValidUserProfile(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'receivePlatformUpdates', 'receiveBlogUpdates', 'updatedAt']);
      allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // Subscriber Entity Validation
    function isValidSubscriber(data) {
      return data.email is string && data.email.size() >= 3 && data.email.size() <= 128 &&
        (!('name' in data) || (data.name is string && data.name.size() <= 100)) &&
        (!('uid' in data) || (data.uid is string && data.uid.size() <= 128)) &&
        data.subscribedAt is string && data.subscribedAt.size() <= 64 &&
        data.receivePlatformUpdates is bool &&
        (!('receiveBlogUpdates' in data) || data.receiveBlogUpdates is bool);
    }

    match /subscribers/{subscriberId} {
      allow create: if isValidId(subscriberId) &&
        isValidSubscriber(incoming()) &&
        (!('uid' in incoming()) || (isSignedIn() && incoming().uid == request.auth.uid));
      allow get: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow list: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.uid == request.auth.uid &&
        isValidSubscriber(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'receivePlatformUpdates', 'receiveBlogUpdates'])
      );
      allow delete: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    // Inquiry Entity Validation & Protection against tampering
    function isValidInquiry(data) {
      return data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 128 &&
        data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 200 &&
        data.message is string && data.message.size() >= 1 && data.message.size() <= 2000 &&
        data.createdAt is string && data.createdAt.size() <= 64;
    }

    match /inquiries/{inquiryId} {
      allow create: if isValidId(inquiryId) && isValidInquiry(incoming());
      allow get, list, delete: if isAdmin();
      allow update: if false;
    }
  }
}
