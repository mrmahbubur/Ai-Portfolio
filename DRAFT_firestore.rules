rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all rule for security
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable validation helpers
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidEmail(email) {
      return email is string &&
        email.size() >= 3 &&
        email.size() <= 128 &&
        email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$');
    }

    function isValidTimestampString(ts) {
      return ts is string && ts.size() >= 10 && ts.size() <= 64;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Administrative verification based on verified portfolio owner email
    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email == 'mr216873@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    // User Profile Validation & Strict Key Blueprint (matches firebase-blueprint.json)
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt']) &&
        data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'receivePlatformUpdates',
          'receiveBlogUpdates',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.uid) &&
        isValidEmail(data.email) &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100)) &&
        (!('receivePlatformUpdates' in data) || data.receivePlatformUpdates is bool) &&
        (!('receiveBlogUpdates' in data) || data.receiveBlogUpdates is bool) &&
        isValidTimestampString(data.createdAt) &&
        (!('updatedAt' in data) || isValidTimestampString(data.updatedAt));
    }

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() &&
        isValidId(userId) &&
        request.auth.uid == userId &&
        incoming().uid == request.auth.uid &&
        isValidUserProfile(incoming());
      allow update: if isSignedIn() &&
        isValidId(userId) &&
        request.auth.uid == userId &&
        incoming().uid == existing().uid &&
        incoming().email == existing().email &&
        incoming().createdAt == existing().createdAt &&
        isValidUserProfile(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'receivePlatformUpdates',
          'receiveBlogUpdates',
          'updatedAt'
        ]);
      allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // Subscriber Entity Validation & Strict Key Blueprint (matches firebase-blueprint.json)
    function isValidSubscriber(data) {
      return data.keys().hasAll(['email', 'subscribedAt', 'receivePlatformUpdates']) &&
        data.keys().hasOnly([
          'email',
          'name',
          'uid',
          'subscribedAt',
          'receivePlatformUpdates',
          'receiveBlogUpdates'
        ]) &&
        isValidEmail(data.email) &&
        (!('name' in data) || (data.name is string && data.name.size() >= 1 && data.name.size() <= 100)) &&
        (!('uid' in data) || isValidId(data.uid)) &&
        isValidTimestampString(data.subscribedAt) &&
        data.receivePlatformUpdates is bool &&
        (!('receiveBlogUpdates' in data) || data.receiveBlogUpdates is bool);
    }

    match /subscribers/{subscriberId} {
      allow create: if isValidId(subscriberId) &&
        isValidSubscriber(incoming()) &&
        (!('uid' in incoming()) || (isSignedIn() && incoming().uid == request.auth.uid));
      allow get: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow list: if isAdmin();
      allow update: if (
        isAdmin() &&
        isValidSubscriber(incoming())
      ) || (
        isSignedIn() &&
        isValidId(subscriberId) &&
        resource.data.uid == request.auth.uid &&
        incoming().email == existing().email &&
        incoming().subscribedAt == existing().subscribedAt &&
        (!('uid' in existing()) || incoming().uid == existing().uid) &&
        isValidSubscriber(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name',
          'receivePlatformUpdates',
          'receiveBlogUpdates'
        ])
      );
      allow delete: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    // Inquiry Entity Validation & Strict Key Blueprint (matches firebase-blueprint.json)
    function isValidInquiry(data) {
      return data.keys().hasAll(['name', 'email', 'subject', 'message', 'createdAt']) &&
        data.keys().hasOnly(['name', 'email', 'subject', 'message', 'createdAt']) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        isValidEmail(data.email) &&
        data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 200 &&
        data.message is string && data.message.size() >= 1 && data.message.size() <= 2000 &&
        isValidTimestampString(data.createdAt);
    }

    match /inquiries/{inquiryId} {
      allow create: if isValidId(inquiryId) && isValidInquiry(incoming());
      allow get, list, delete: if isAdmin();
      allow update: if false;
    }
  }
}
